{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "node",
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": false,
		"noImplicitAny": true,
		"types": ["node"]
	},
	"include": ["types/**/*.d.ts", "app.js", "app/**/*.js", "app/**/*.ts", "routes/**/*.js", "routes/**/*.ts", "bin/**/*.js", "bin/**/*.ts"],
	"exclude": ["node_modules", "public"]
}
