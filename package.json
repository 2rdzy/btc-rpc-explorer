{
	"name": "btc-rpc-explorer",
	"version": "3.5.1",
	"description": "Open-source, self-hosted explorer for the BLAKE2b Bitcoin Knots chain",
	"private": false,
	"bin": "dist/bin/cli.js",
	"scripts": {
		"start": "node --enable-source-maps ./dist/bin/www.js",
		"test": "node --import tsx --test test/*.test.js",
		"miners": "node ./bin/refresh-mining-pool-configs.js",
		"integrity": "node ./bin/frontend-resource-integrity.js",
		"lint": "eslint .",
		"css-light-debug": "sass --style expanded ./public/scss/light.scss ./public/style/light.css",
		"css-dark-debug": "sass --style expanded ./public/scss/dark.scss ./public/style/dark.css",
		"css-dark-v1-debug": "sass --style expanded ./public/scss/dark-v1.scss ./public/style/dark-v1.css",
		"css-debug": "npm run css-light-debug && npm run css-dark-debug && npm run css-dark-v1-debug",
		"css-light": "sass --style compressed ./public/scss/light.scss ./public/style/light.min.css",
		"css-dark": "sass --style compressed ./public/scss/dark.scss ./public/style/dark.min.css",
		"css-dark-v1": "sass --style compressed ./public/scss/dark-v1.scss ./public/style/dark-v1.min.css",
		"css": "npm run css-light && npm run css-dark && npm run css-dark-v1 && npm run integrity",
		"typecheck": "node bin/typecheck.js && tsc -p tsconfig.strict.json",
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"bitcoin",
		"bitcoin-knots",
		"blake2b",
		"btc",
		"blockchain"
	],
	"author": "Dan Janosik <dan@47.io>",
	"license": "MIT",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/2rdzy/btc-rpc-explorer.git"
	},
	"bugs": {
		"url": "https://github.com/2rdzy/btc-rpc-explorer/issues"
	},
	"homepage": "https://github.com/2rdzy/btc-rpc-explorer#readme",
	"dependencies": {
		"async": "^3.2.6",
		"axios": "^1.11.0",
		"basic-auth": "^2.0.1",
		"bech32": "2.0.0",
		"bip32": "^4.0.0",
		"bitcoinjs-lib": "^6.1.7",
		"body-parser": "^2.2.0",
		"bootstrap": "^5.3.7",
		"bs58check": "^4.0.0",
		"chart.js": "^4.5.0",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"crypto-js": "^4.2.0",
		"csrf-sync": "^4.2.1",
		"debug": "^4.4.1",
		"decimal.js": "^10.6.0",
		"dotenv": "^13.0.1",
		"electrum-client": "github:2rdzy/electrum-client#4d08c8dd91b231ea28bb91f03853f018ede19b3b",
		"express": "^4.21.2",
		"express-async-handler": "^1.2.0",
		"express-rate-limit": "^8.0.1",
		"express-session": "^1.18.2",
		"jayson": "^5.0.0",
		"lru-cache": "^10.4.3",
		"markdown-it": "^14.1.0",
		"memorystore": "^1.6.7",
		"meow": "^9.0.0",
		"moment": "^2.30.1",
		"moment-duration-format": "^2.3.2",
		"morgan": "^1.10.1",
		"on-headers": "^1.1.0",
		"pidusage": "^4.0.1",
		"pug": "^3.0.3",
		"qrcode": "^1.5.4",
		"redis": "^4.7.1",
		"semver": "^7.7.2",
		"serve-favicon": "^2.5.1",
		"simple-git": "^4.0.2",
		"tiny-secp256k1": "^2.2.4",
		"zeromq": "^6.5.0"
	},
	"optionalDependencies": {
		"event-loop-stats": "^1.4.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/async": "^3.2.26",
		"@types/basic-auth": "^1.1.8",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/crypto-js": "^4.2.2",
		"@types/debug": "^4.1.13",
		"@types/express": "^4.17.25",
		"@types/express-session": "^1.19.0",
		"@types/markdown-it": "^14.2.0",
		"@types/moment-duration-format": "^2.2.7",
		"@types/morgan": "^1.9.10",
		"@types/node": "^22.20.5",
		"@types/on-headers": "^1.0.4",
		"@types/pidusage": "^2.0.5",
		"@types/pug": "^2.0.10",
		"@types/qrcode": "^1.5.6",
		"@types/semver": "^7.8.0",
		"@types/serve-favicon": "^2.5.7",
		"eslint": "^9.34.0",
		"globals": "^14.0.0",
		"sass": "^1.90.0",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1"
	}
}
